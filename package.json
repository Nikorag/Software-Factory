{
  "name": "software-factory",
  "version": "0.2.0",
  "description": "Local-first autonomous software factory",
  "scripts": {
    "build": "pnpm web:build && tsc -p tsconfig.json --noEmit false --rootDir . --outDir dist",
    "typecheck": "tsc --noEmit && pnpm --filter software-factory-web typecheck",
    "lint": "eslint .",
    "test": "pnpm web:build && vitest run && pnpm web:test",
    "db:generate": "drizzle-kit generate",
    "factory": "tsx src/cli.ts",
    "web:dev": "pnpm --filter software-factory-web dev",
    "web:build": "pnpm --filter software-factory-web build",
    "web:test": "pnpm --filter software-factory-web test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.23.0",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "commander": "^15.1.0",
    "drizzle-orm": "^0.45.4",
    "electron": "^45.4.1",
    "fastify": "^5.12.8",
    "picomatch": "^4.0.7",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
