{
  "name": "software-factory-hub",
  "version": "0.2.0",
  "private": true,
  "description": "Central Software Factory Hub (PostgreSQL + Redis, Kubernetes-deployable)",
  "type": "module",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts serve",
    "start": "node dist/cli.js serve"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.1.0",
    "bullmq": "^5.0.0",
    "fastify": "^5.12.8",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
