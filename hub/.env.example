# Local development only. Production uses a Kubernetes ConfigMap + Secret (see docs/hub-operations.md).
NODE_ENV=development
PUBLIC_URL=http://localhost:8080
LOG_LEVEL=debug
DATABASE_URL=postgres://hub:hub@localhost:5432/hub
REDIS_URL=redis://localhost:6379
SETUP_TOKEN=dev-only-setup-token-0000000000
SESSION_SECRET=dev-only-session-secret-change-me-0000000000
FACTORY_TOKEN_PEPPER=dev-only-factory-pepper-change-me-000000000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080
# generate with: node dist/cli.js vapid-generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.test
